<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Cores Principais da Marca -->
    <Color x:Key="Primary">#F47B20</Color>
    <Color x:Key="PrimaryDark">#D8610A</Color>

    <!-- Cores de Texto (Consolidadas) -->

    <!-- ADICIONADA: Esta é a chave que estava faltando e causando o crash -->
    <Color x:Key="PrimaryText">#FFFFFF</Color>

    <Color x:Key="PrimaryTextLight">#1F1F1F</Color>
    <Color x:Key="SecondaryTextLight">#666666</Color>
    <Color x:Key="PrimaryTextDark">#FFFFFF</Color>
    <Color x:Key="SecondaryTextDark">#A9A9A9</Color>

    <!-- ADICIONADAS: Chaves do outro projeto que você vai precisar -->
    <Color x:Key="PrimaryTextColor">#333333</Color>
    <Color x:Key="SecondaryTextColor">#666666</Color>


    <!-- Cores de Fundo (Consolidadas) -->
    <Color x:Key="PageBackgroundColorLight">#F7F7F7</Color>
    <Color x:Key="CardBackgroundColorLight">#FFFFFF</Color>
    <Color x:Key="PageBackgroundColorDark">#121212</Color>
    <Color x:Key="CardBackgroundColorDark">#1E1E1E</Color>

    <!-- ADICIONADAS: Chaves do outro projeto que a AberturaPage usa -->
    <Color x:Key="PageBackgroundColor">#F7F7F7</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>


    <!-- Cores Neutras (Consolidadas) -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#F2F2F2</Color>
    <Color x:Key="Gray200">#E0E0E0</Color>
    <Color x:Key="Gray300">#C6C6C6</Color>
    <Color x:Key="Gray400">#8E8E8E</Color>
    <Color x:Key="Gray500">#828282</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Cores de Feedback -->
    <Color x:Key="SuccessColor">#28A745</Color>
    <Color x:Key="DangerColor">#E53935</Color>
    <Color x:Key="WarningColor">#FFC107</Color>

</ResourceDictionary>