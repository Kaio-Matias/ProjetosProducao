<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Cores Principais da Marca (Originais do seu App) -->
    <Color x:Key="Primary">#F47B20</Color>
    <Color x:Key="PrimaryDark">#D8610A</Color>

    <!-- Cores de Texto (Originais do seu App) -->
    <Color x:Key="PrimaryText">#FFFFFF</Color>
    <!-- Para texto sobre fundos escuros/primários -->
    <Color x:Key="PrimaryTextColor">#333333</Color>
    <!-- Para texto principal em fundos claros -->
    <Color x:Key="SecondaryTextColor">#666666</Color>
    <!-- Para texto secundário em fundos claros -->

    <!-- Cores de Fundo (Originais do seu App) -->
    <Color x:Key="PageBackgroundColor">#F7F7F7</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>
    <!-- Fundo para modo escuro -->

    <!-- Cores Neutras (Consolidadas) -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#8E8E8E</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Cores de Feedback (Sugestão) -->
    <Color x:Key="SuccessColor">#28A745</Color>
    <Color x:Key="DangerColor">#DC3545</Color>
    <Color x:Key="WarningColor">#FFC107</Color>

</ResourceDictionary>
