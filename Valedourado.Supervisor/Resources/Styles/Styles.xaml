<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#F47B20</Color>
    <Color x:Key="PrimaryDark">#D8610A</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="PrimaryTextLight">#1F1F1F</Color>
    <Color x:Key="SecondaryTextLight">#666666</Color>
    <Color x:Key="PrimaryTextDark">#FFFFFF</Color>
    <Color x:Key="SecondaryTextDark">#A9A9A9</Color>

    <Color x:Key="PageBackgroundColorLight">#F7F7F7</Color>
    <Color x:Key="CardBackgroundColorLight">#FFFFFF</Color>
    <Color x:Key="PageBackgroundColorDark">#121212</Color>
    <Color x:Key="CardBackgroundColorDark">#1E1E1E</Color>

    <Color x:Key="Gray100">#F2F2F2</Color>
    <Color x:Key="Gray200">#E0E0E0</Color>
    <Color x:Key="Gray300">#C6C6C6</Color>
    <Color x:Key="Gray500">#828282</Color>
    <Color x:Key="Gray900">#212121</Color>

    <Color x:Key="SuccessColor">#28A745</Color>
    <Color x:Key="DangerColor">#E53935</Color>
    <Color x:Key="WarningColor">#FFC107</Color>

    <Style TargetType="Shell">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource White}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Gray200}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource White}" />
    </Style>

    <Style x:Key="Title1" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Style>
    <Style x:Key="Title2" TargetType="Label" BasedOn="{StaticResource Title1}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
    </Style>
    <Style x:Key="LabelBold" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="16" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style x:Key="InputContainer" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Gray300}" />
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackgroundColorLight}, Dark={StaticResource PageBackgroundColorDark}}"/>
        <Setter Property="MinimumHeightRequest" Value="48"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackgroundColorLight}, Dark={StaticResource CardBackgroundColorDark}}"/>
    </Style>
    <Style x:Key="FilterContainer" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 0,0,15,15"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource CardBackgroundColorDark}}"/>
    </Style>

    <Style x:Key="HorizontalRule" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="BorderWidth" Value="0"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerColor}"/>
    </Style>
    <Style x:Key="TransparentButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

</ResourceDictionary>