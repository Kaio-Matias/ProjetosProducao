<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Valedourado.Supervisor.ViewModels"
             x:Class="Valedourado.Supervisor.Views.LoginPage"
             x:DataType="viewmodel:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Primary}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">
                <Image Source="logo_valedourado.png" HeightRequest="90" HorizontalOptions="Center" Margin="0,20,0,10"/>
                <Label Text="Portal do Supervisor" Style="{StaticResource Title1}" TextColor="{StaticResource White}" HorizontalOptions="Center" Margin="0,0,0,20"/>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource White}"/>
                <Border Style="{StaticResource InputContainer}">
                    <Entry Placeholder="Digite sua Matrícula" Text="{Binding Matricula}" Keyboard="Numeric" />
                </Border>
                <Button Text="Entrar" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource PrimaryButton}" BackgroundColor="{StaticResource White}" TextColor="{StaticResource Primary}"/>
                <Label HorizontalOptions="Center" Margin="0,10,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Não tem uma conta? " TextColor="{StaticResource White}"/>
                            <Span Text="Registre-se" TextColor="{StaticResource White}" FontAttributes="Bold" TextDecorations="Underline">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>