<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Valedourado.ViewModels"
             xmlns:converters="clr-namespace:Valedourado.Converters"
             x:Class="Valedourado.Views.RecordLossesPage"
             x:DataType="viewmodel:RecordLossesViewModel"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="{StaticResource Primary}">
        <Grid Grid.Row="0" Padding="15,20" ColumnDefinitions="Auto, *">
            <Button Grid.Column="0" Text="‹ Voltar" Command="{Binding GoBackCommand}" Style="{StaticResource TransparentButton}"/>
            <Label Grid.Column="1" Text="Registro de Perdas" Style="{StaticResource Title2}" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <Border Grid.Row="1" Grid.RowSpan="2" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColor}, Dark={StaticResource OffBlack}}" StrokeShape="RoundRectangle 30,30,0,0">
            <Grid RowDefinitions="*, Auto">
                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Spacing="15" Padding="20">
                        <Label Text="{Binding OrdemProducao, StringFormat='OP: {0}'}" HorizontalOptions="Center" Style="{StaticResource Caption}"/>
                        <Label Text="{Binding Operador, StringFormat='Operador: {0}'}" HorizontalOptions="Center" Style="{StaticResource Caption}" Margin="0,0,0,10"/>

                        <Border Style="{StaticResource Card}" IsVisible="{Binding SelectedMotivos.Count, Converter={StaticResource CountToBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Quantidades por Motivo" Style="{StaticResource Title2}"/>
                                <CollectionView ItemsSource="{Binding SelectedMotivos}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:MotivoPerda">
                                            <Grid ColumnDefinitions="*, Auto" Padding="0,5">
                                                <Label Grid.Column="0" Text="{Binding Motivo}" VerticalOptions="Center"/>
                                                <Entry Grid.Column="1" Text="{Binding Quantidade}" Keyboard="Numeric" WidthRequest="80" HorizontalTextAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                                    <Label Grid.Column="0" Text="Total de Perdas:" Style="{StaticResource Body}" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding TotalPerdas}" Style="{StaticResource Body}" FontAttributes="Bold"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Selecione os Motivos" Style="{StaticResource Title2}"/>
                                <CollectionView ItemsSource="{Binding AllMotivos}">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:SelectableMotivoItem">
                                            <Button Text="{Binding Motivo}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:RecordLossesViewModel}}, Path=ToggleMotivoSelectionCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SecondaryButton}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Button Grid.Row="1" Text="Salvar Perdas" Command="{Binding SaveCommand}" Margin="20" Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>