<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Valedourado.ViewModels"
             xmlns:converters="clr-namespace:Valedourado.Converters"
             xmlns:dto="clr-namespace:Valedourado.Shared.Dtos;assembly=Valedourado.Shared"
             x:Class="Valedourado.Views.RecordEfficiencyPage"
             x:DataType="viewmodel:RecordEfficiencyViewModel"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="{StaticResource Primary}">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="15,20">
            <Button Grid.Column="0" Text="‹ Voltar" Command="{Binding GoBackCommand}" Style="{StaticResource TransparentButton}"/>
            <Label Grid.Column="1" Text="Registro de Eficiência" Style="{StaticResource Title2}" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <Border Grid.Row="1" Grid.RowSpan="2" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColor}, Dark={StaticResource OffBlack}}" StrokeShape="RoundRectangle 30,30,0,0">
            <Grid RowDefinitions="*, Auto">
                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Spacing="15" Padding="20">
                        <Label Text="{Binding OrdemProducao, StringFormat='OP: {0}'}" HorizontalOptions="Center" Style="{StaticResource Caption}"/>
                        <Label Text="{Binding Operador, StringFormat='Operador: {0}'}" HorizontalOptions="Center" Style="{StaticResource Caption}" Margin="0,0,0,10"/>

                        <Border Style="{StaticResource Card}" 
                                IsVisible="{Binding RegistrosExistentes.Count, Converter={StaticResource CountToBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Meus Lançamentos (Eficiência)" Style="{StaticResource Title2}"/>
                                <CollectionView ItemsSource="{Binding RegistrosExistentes}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="dto:EficienciaDto">
                                            <Grid ColumnDefinitions="*, Auto" Padding="0,5">
                                                <Label Grid.Column="0" 
                                                       Text="{Binding Motivo}" 
                                                       VerticalOptions="Center"/>
                                                <Label Grid.Column="1" 
                                                       Text="{Binding Tempo, StringFormat='{0:HH\\:mm}'}" 
                                                       FontAttributes="Bold" 
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource Card}" IsVisible="{Binding SelectedMotivos.Count, Converter={StaticResource CountToBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Tempo Gasto (Horas:Minutos)" Style="{StaticResource Title2}"/>
                                <CollectionView ItemsSource="{Binding SelectedMotivos}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:MotivoTempo">
                                            <Grid ColumnDefinitions="*, Auto" Padding="0,5">
                                                <Label Grid.Column="0" Text="{Binding Motivo}" VerticalOptions="Center"/>
                                                <TimePicker Grid.Column="1" Time="{Binding Tempo}" Format="HH:mm" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                                    <Label Grid.Column="0" Text="Total de Horas:" FontAttributes="Bold" Style="{StaticResource Body}"/>
                                    <Label Grid.Column="1" Text="{Binding TotalTempo, StringFormat='{0:HH\\:mm}'}" FontAttributes="Bold" Style="{StaticResource Body}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Selecione os Motivos de Parada" Style="{StaticResource Title2}"/>
                                <CollectionView ItemsSource="{Binding AllMotivos}">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:SelectableMotivoItem">
                                            <Button Text="{Binding Motivo}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:RecordEfficiencyViewModel}}, Path=ToggleMotivoSelectionCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SecondaryButton}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Button Grid.Row="1" Text="Salvar Eficiência" Command="{Binding SaveCommand}" Margin="20" Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>